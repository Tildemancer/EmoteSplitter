<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.5.2</Version>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\build\TildeTools</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <Author>Tildemancer</Author>
    <Name>TildeTools</Name>
    <Punchline>A box of small tools, each switched on or off on its own.</Punchline>
    <Description>A collection of tools under one window, each with its own tab and master switch. Includes Emote Splitter, which raises the chat box's length limit and sends long messages as paced parts so the server does not drop them, and spellcheck.</Description>
    <Tags>Social;Utility;Roleplay</Tags>
  </PropertyGroup>

</Project>
